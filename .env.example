# CognoDB Cloud (Free tier: c0, burst to 0.5 vCPU, 512 MB RAM, 1 GiB disk)
COGNODB_URI=bolt+s://your-instance.databases.cognodb.com:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Neo4j AuraDB Free
AURA_URI=neo4j+s://your-instance.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# Memgraph (self-hosted Docker, capped to 0.5 vCPU / 512 MB to match CognoDB)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ArangoDB (self-hosted Docker, capped to 0.5 vCPU / 512 MB to match CognoDB)
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark

NEO4J_SELFHOSTED_URI=bolt://localhost:7688
NEO4J_SELFHOSTED_USER=neo4j
NEO4J_SELFHOSTED_PASSWORD=benchmarkpass123